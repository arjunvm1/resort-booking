
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
# MongoDB Atlas or a local replica set is required for inventory transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/resort_booking?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# Leave blank to run without online payments. Use test keys during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Configure this to match the resort's actual tax policy.
TAX_PERCENT=12
TRUST_PROXY=0
# Only used by npm run seed:admin.
ADMIN_NAME=Resort Manager
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Supabase Storage: server-only secret key or legacy service_role key.
SUPABASE_URL=https://ombgugyzrniyrdffksgl.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=room-images
